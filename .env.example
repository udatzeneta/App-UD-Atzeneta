# VARIABLES DE ENTORNO DE SUPABASE (UD ATZENETA ERP)
# Duplica este archivo como '.env' en la raíz y rellena tus datos

# Claves para la app web (Vite)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key-here

# Clave de servicio para scripts de servidor (sync_matches_supabase.cjs)
# La encuentras en: Supabase Dashboard > Settings > API > service_role key
# ⚠️ NO expongas esta clave en el frontend ni en el repositorio
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
